# Copia este archivo como .env y ajusta los valores.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
# Direcciones con las que se accede al campus (ej: 192.168.1.50,campus.latina.local)
DJANGO_ALLOWED_HOSTS=*
# Necesario si se usa un dominio con https, ej: https://campus.latina.com.ec
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Identidad ---
CAMPUS_NAME=Campus Latina
CAMPUS_COMPANY=Industrial Latina S.A.
CAMPUS_SIGNER_1=Gerencia Comercial
CAMPUS_SIGNER_2=Jefatura de Capacitación
# URL pública que va en el QR de los certificados (vacía = la dirección actual)
CAMPUS_PUBLIC_URL=

# --- Base de datos (opcional: SQL Server) ---
# Sin estas líneas se usa SQLite (un archivo en el servidor).
# DB_HOST puede ser "servidor" o "servidor\INSTANCIA". Sin DB_USER se usa
# autenticación de Windows con la identidad del sitio en IIS.
# DB_ENGINE=sqlserver
# DB_NAME=CampusLatina
# DB_HOST=localhost
# DB_PORT=
# DB_USER=campus
# DB_PASSWORD=
# DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Base de datos (opcional: PostgreSQL) ---
# DB_ENGINE=postgresql
# DB_NAME=campus_latina
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Login corporativo Syspro (opcional) ---
SYSPRO_ENABLED=False
SYSPRO_API_URL=http://181.78.203.134:7070/api/syspro/users
# Respaldos (se prueban en orden si la principal no responde)
SYSPRO_API_URLS=http://192.168.1.97:7070/api/syspro/users
SYSPRO_API_KEY=
SYSPRO_TIMEOUT=5
# Usuarios de Syspro que entran como administradores (separados por coma)
SYSPRO_ADMIN_USERS=

# Copia este archivo como .env y ajusta los valores.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
# Direcciones con las que se accede al campus (ej: 192.168.1.50,campus.latina.local)
DJANGO_ALLOWED_HOSTS=*
# Necesario si se usa un dominio con https, ej: https://campus.latina.com.ec
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Identidad ---
CAMPUS_NAME=Campus Latina
CAMPUS_COMPANY=Industrial Latina S.A.
CAMPUS_SIGNER_1=Gerencia Comercial
CAMPUS_SIGNER_2=Jefatura de Capacitación
# URL pública que va en el QR de los certificados (vacía = la dirección actual)
CAMPUS_PUBLIC_URL=

# --- Login corporativo Syspro ---
# Los usuarios del campus son los de Syspro: sin esto nadie puede ingresar.
SYSPRO_ENABLED=True
SYSPRO_API_URL=http://181.78.203.134:7070/api/syspro/users
# Respaldos (se prueban en orden si la principal no responde)
SYSPRO_API_URLS=http://192.168.1.97:7070/api/syspro/users
SYSPRO_API_KEY=
SYSPRO_TIMEOUT=5
# Usuarios de Syspro que entran como administradores (separados por coma)
SYSPRO_ADMIN_USERS=

# --- Datos del campus (API) ---
# Todos los datos (cursos, avance, evaluaciones, certificados...) se guardan en SQL Server
# a través de este endpoint. Sin CAMPUS_API_URL el campus usa solo una base local de prueba.
CAMPUS_API_URL=http://192.168.1.97:7070/api/syspro/campus/datos
# Respaldos (se prueban en orden si la principal no responde)
CAMPUS_API_URLS=http://181.78.203.134:7070/api/syspro/campus/datos
# Vacía = usa la misma SYSPRO_API_KEY
CAMPUS_API_KEY=
CAMPUS_API_TIMEOUT=20
# Cada cuántos segundos se vuelven a leer los datos de la API, para ver los cambios
# hechos desde otro campus (0 = solo al arrancar).
CAMPUS_API_REFRESH_SECONDS=15
# Cada cuántos segundos las páginas abiertas se actualizan solas si hubo cambios (0 = nunca).
CAMPUS_LIVE_SECONDS=10
